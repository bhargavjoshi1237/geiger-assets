# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only key for AVIF thumbnail uploads to the assets-thumbnails bucket.
SUPABASE_SERVICE_ROLE_KEY=
STRING_URI=

# S3 object storage (server-only — never NEXT_PUBLIC_)
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=3600
S3_UPLOAD_URL_TTL=900
S3_MAX_UPLOAD_BYTES=524288000
# Appwrite's S3 gateway answers presigned URLs with 501 — it only speaks
# SigV4-in-header (SDK calls). false = proxy-first: uploads POST through the
# server (4 MB cap) and reads stream through the server. true = spec design
# (presigned PUT direct + presigned GET), for real AWS gateways.
S3_PRESIGNED_UPLOADS=false
S3_PRESIGNED_READS=false

# Storage backend seam (write side only — reads always follow the asset row).
# s3 (default) = today's single-bucket behaviour, inert. pool = place new
# objects in the geiger-dash storage pool via the API below.
ASSETS_STORAGE_BACKEND=s3
# Dash origin backing the pool, e.g. https://dash.geiger.example/
GEIGER_STORAGE_API_URL=
# Namespace-scoped pool key (gs_live_…). Server-only — never NEXT_PUBLIC_.
GEIGER_STORAGE_API_KEY=

# This app's own public origin, used to build share links. Falls back to
# window.location.origin when unset.
NEXT_PUBLIC_APP_URL=

# Parent suite origin (geiger-dash) — owns the auth cookie and the login page.
NEXT_PUBLIC_DASH_ORIGIN=https://geiger.studio
