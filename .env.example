# Supabase (browser + server)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
STRING_URI=

# S3 object storage (server-only — never NEXT_PUBLIC_)
# This file is committed. Every secret stays blank here; real values live in
# .env.local, which is gitignored.
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_FORCE_PATH_STYLE=true
S3_SIGNED_URL_TTL=3600
S3_UPLOAD_URL_TTL=900
S3_MAX_UPLOAD_BYTES=524288000
# Appwrite's S3 gateway answers presigned URLs with 501 — it only speaks
# SigV4-in-header (SDK calls). false = proxy-first: uploads POST through the
# server (4 MB cap) and reads stream through the server. true = spec design
# (presigned PUT direct + presigned GET), for real AWS gateways.
S3_PRESIGNED_UPLOADS=false
S3_PRESIGNED_READS=false

# Signing key for public delivery tokens (lib/media/token.js). Generate with
# `node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"`.
# Rotating it invalidates every outstanding share link.
MEDIA_TOKEN_SECRET=
