# Appwrite's S3 gateway answers presigned URLs with 501 — it only speaks
# SigV4-in-header (SDK calls). false = proxy-first: uploads POST through the
# server (4 MB cap) and reads stream through the server. true = spec design
# (presigned PUT direct + presigned GET), for real AWS gateways.
S3_PRESIGNED_UPLOADS=false
S3_PRESIGNED_READS=false
